{
  "name": "agrouter-docs",
  "compatibility_date": "2026-08-26",
  "main": "./worker/index.js",
  "routes": [
    {
      "pattern": "agrouter.ai/docs",
      "zone_name": "agrouter.ai"
    },
    {
      "pattern": "agrouter.ai/docs/*",
      "zone_name": "agrouter.ai"
    },
    {
      "pattern": "www.agrouter.ai/docs",
      "zone_name": "agrouter.ai"
    },
    {
      "pattern": "www.agrouter.ai/docs/*",
      "zone_name": "agrouter.ai"
    }
  ],
  "assets": {
    "directory": "./.vitepress/dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
}
