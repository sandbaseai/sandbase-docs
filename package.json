{
  "name": "SandBase-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "build:cloudflare": "npm run build",
    "preview": "vitepress preview",
    "lint:openapi": "redocly lint public/openapi.yaml --extends=minimal",
    "test:public-api": "node scripts/validate-public-api-surface.mjs",
    "test:api-reference": "node scripts/validate-api-reference-contract.mjs",
    "test:http-references": "node scripts/validate-http-references.mjs",
    "test:links": "node scripts/validate-internal-links.mjs",
    "test:seo": "node scripts/validate-seo.mjs",
    "test:ai-readable": "node scripts/validate-ai-readable.mjs",
    "test:setup-docs": "node scripts/validate-setup-docs.mjs",
    "test:auth-docs": "node scripts/validate-auth-docs.mjs",
    "test:doc-content": "node scripts/validate-doc-content.mjs",
    "test:worker": "node scripts/test-worker.mjs",
    "test:built-public-api": "node scripts/validate-built-public-surface.mjs",
    "validate": "npm run lint:openapi && npm run test:public-api && npm run test:api-reference && npm run test:http-references && npm run test:links && npm run test:seo && npm run test:ai-readable && npm run test:setup-docs && npm run test:auth-docs && npm run test:doc-content && npm run test:worker && npm run build && npm run test:built-public-api",
    "test:generator": "node --test scripts/generate-llm-model-api-reference.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "^2.47.0",
    "vitepress": "^1.6.0",
    "vue": "^3.5.0",
    "yaml": "^2.9.0"
  }
}
